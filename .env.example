# Fill these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# --- AWS (IAM user limited to iam-policy.json) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
LIGHTSAIL_INSTANCE=FlyToSig

# --- Cloudflare (API token: Zone.DNS:Edit + Zone.Analytics:Read on picone.asia only) ---
CF_API_TOKEN=
CF_ZONE_ID=
CF_RECORD_NAMES=a.picone.asia,b.picone.asia
# Hosts whose HTTP traffic is charted (others only show DNS query counts)
CF_TRAFFIC_HOSTS=a.picone.asia

# --- Login ---
ADMIN_USERNAME=
# Output of `npm run hash-password`
ADMIN_PASSWORD_HASH=
# >= 32 random chars: `openssl rand -hex 32`
SESSION_SECRET=

# --- Upstash Redis (injected automatically by the Vercel Marketplace integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
