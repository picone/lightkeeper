# Fill these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# --- AWS (IAM user limited to iam-policy.json) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Name of the Lightsail instance to manage
LIGHTSAIL_INSTANCE=

# --- Cloudflare (API token: Zone.DNS:Edit + Zone.Analytics:Read on your zone only) ---
CF_API_TOKEN=
CF_ZONE_ID=
# Comma-separated A records that point at the instance (updated on IP rotation)
CF_RECORD_NAMES=a.example.com,b.example.com
# Hosts whose HTTP traffic is charted (others only show DNS query counts).
# Optional; defaults to CF_RECORD_NAMES.
CF_TRAFFIC_HOSTS=a.example.com

# --- Login ---
ADMIN_USERNAME=
# Output of `npm run hash-password`
ADMIN_PASSWORD_HASH=
# >= 32 random chars: `openssl rand -hex 32`
SESSION_SECRET=

# --- Upstash Redis (injected automatically by the Vercel Marketplace integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
